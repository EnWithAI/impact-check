{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changelens:report:2.0",
  "title": "ChangeLens impact report",
  "description": "Output of `changelens analyze --format json`, schema version 2.0. Normalization for determinism: run_metadata.generated_at, run_metadata.duration_ms, run_metadata.timings_ms and run_metadata.node_version vary between runs; everything else is identical for identical inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_revision",
    "base_revision",
    "repository",
    "summary",
    "changed_files",
    "affected_modules",
    "findings",
    "test_candidates",
    "coverage_limitations",
    "run_metadata"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "repo_revision": {
      "description": "The analyzed (head) state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "kind", "worktree"],
      "properties": {
        "ref": { "type": "string", "description": "Ref given by the user, or \"WORKTREE\"." },
        "commit": {
          "$ref": "#/$defs/sha",
          "description": "Analyzed commit, or HEAD's commit in worktree mode."
        },
        "kind": { "enum": ["commit", "worktree"] },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "staged", "unstaged", "untracked"],
          "properties": {
            "included": { "type": "boolean" },
            "staged": { "type": "integer", "minimum": 0 },
            "unstaged": { "type": "integer", "minimum": 0 },
            "untracked": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "base_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "merge_base", "diff_mode"],
      "properties": {
        "ref": { "type": "string" },
        "commit": { "$ref": "#/$defs/sha" },
        "merge_base": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "diff_mode": { "enum": ["merge-base", "direct"] }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "is_shallow", "ts_config", "workspace_packages", "context"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Basename of the repository root. No absolute paths are emitted."
        },
        "is_shallow": { "type": "boolean" },
        "ts_config": { "type": ["string", "null"] },
        "workspace_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": { "name": { "type": "string" }, "path": { "type": "string" } }
          }
        },
        "context": { "$ref": "#/$defs/context" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_mode",
        "files_changed",
        "js_ts_files_changed",
        "affected_modules",
        "findings_by_severity",
        "findings_by_status",
        "test_candidates",
        "coverage_limitations"
      ],
      "properties": {
        "analysis_mode": {
          "enum": ["full", "degraded"],
          "description": "degraded = no usable JS/TS dependency graph; only observed changes are reported."
        },
        "files_changed": { "type": "integer", "minimum": 0 },
        "js_ts_files_changed": { "type": "integer", "minimum": 0 },
        "affected_modules": { "type": "integer", "minimum": 0 },
        "findings_by_severity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "medium", "low", "info"],
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 }
          }
        },
        "findings_by_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified_static_fact", "hypothesis", "unknown"],
          "properties": {
            "verified_static_fact": { "type": "integer", "minimum": 0 },
            "hypothesis": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "test_candidates": { "type": "integer", "minimum": 0 },
        "coverage_limitations": { "type": "integer", "minimum": 0 }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "previous_path",
          "status",
          "binary",
          "generated",
          "language",
          "kind",
          "additions",
          "deletions",
          "origin",
          "changed_lines",
          "provenance"
        ],
        "properties": {
          "path": { "type": "string" },
          "previous_path": { "type": ["string", "null"] },
          "status": { "enum": ["added", "modified", "deleted", "renamed", "type-changed", "unmerged"] },
          "binary": { "type": "boolean" },
          "generated": {
            "type": "boolean",
            "description": "Matches generated-code markers or conventions (inferred)."
          },
          "language": { "enum": ["typescript", "javascript", "json", "other"] },
          "kind": { "enum": ["source", "test", "config", "other"] },
          "additions": { "type": ["integer", "null"], "minimum": 0 },
          "deletions": { "type": ["integer", "null"], "minimum": 0 },
          "origin": { "enum": ["committed", "staged", "unstaged", "untracked", "mixed"] },
          "changed_lines": { "type": "array", "items": { "$ref": "#/$defs/lineRange" } },
          "provenance": { "const": "observed" }
        }
      }
    },
    "affected_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "distance", "provenance", "via", "changed_roots", "evidence"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "enum": ["changed", "dependent"] },
          "distance": { "type": "integer", "minimum": 0 },
          "provenance": { "$ref": "#/$defs/provenance" },
          "via": { "type": "array", "items": { "type": "string" } },
          "changed_roots": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "description": "For dependents: the import edge (in this module) that links it to the previous module in `via`.",
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "test_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reasons", "related_to", "provenance", "execution_status"],
        "properties": {
          "path": { "type": "string" },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["changed-test", "imports-affected-module", "naming-convention"] }
          },
          "related_to": { "type": "array", "items": { "type": "string" } },
          "provenance": { "$ref": "#/$defs/provenance" },
          "execution_status": { "const": "not_run", "description": "ChangeLens never executes tests." }
        }
      }
    },
    "coverage_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "paths", "count"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "message": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "generated_at",
        "duration_ms",
        "timings_ms",
        "node_version",
        "engine",
        "engine_version",
        "parser_version",
        "head_graph",
        "base_graph",
        "limits",
        "config_source",
        "network",
        "executed_repository_code",
        "model_usage",
        "review_effort"
      ],
      "properties": {
        "tool": { "const": "changelens" },
        "tool_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "timings_ms": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "node_version": { "type": "string" },
        "engine": { "const": "dependency-cruiser" },
        "engine_version": { "type": "string" },
        "parser_version": { "type": "string" },
        "head_graph": { "$ref": "#/$defs/graphStats" },
        "base_graph": { "anyOf": [{ "$ref": "#/$defs/graphStats" }, { "type": "null" }] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_depth", "max_affected", "truncated"],
          "properties": {
            "max_depth": { "type": "integer", "minimum": 1 },
            "max_affected": { "type": "integer", "minimum": 1 },
            "truncated": { "type": "boolean" }
          }
        },
        "config_source": { "type": "string", "description": "e.g. \"defaults\", \".changelens.json\"." },
        "network": { "const": false },
        "executed_repository_code": { "const": false },
        "model_usage": {
          "type": "null",
          "description": "No model or paid API is used. Always null in this version."
        },
        "review_effort": {
          "description": "Counts a reviewer has to look at. Proxies only; no time or cost estimates.",
          "type": "object",
          "additionalProperties": false,
          "required": ["files_to_review", "findings_requiring_human_action", "test_candidates"],
          "properties": {
            "files_to_review": { "type": "integer", "minimum": 0 },
            "findings_requiring_human_action": { "type": "integer", "minimum": 0 },
            "test_candidates": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "provenance": {
      "enum": ["observed", "graph", "inferred"],
      "description": "observed = git diff; graph = resolver or parser fact; inferred = heuristic."
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "graphStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "edges", "unresolved_local"],
      "properties": {
        "modules": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "unresolved_local": { "type": "integer", "minimum": 0 }
      }
    },
    "context": {
      "description": "Detected repository context (counts and names only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "module_type", "workspace_tools", "test_frameworks", "module_resolution"],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "files"],
            "properties": { "language": { "type": "string" }, "files": { "type": "integer", "minimum": 0 } }
          }
        },
        "module_type": { "enum": ["module", "commonjs", "unknown"] },
        "workspace_tools": { "type": "array", "items": { "type": "string" } },
        "test_frameworks": { "type": "array", "items": { "type": "string" } },
        "module_resolution": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "side", "line_start", "line_end", "commit", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "diff-hunk",
            "file-status",
            "import-edge",
            "export-declaration",
            "path-pattern",
            "manifest-field",
            "graph-count"
          ]
        },
        "path": { "type": "string" },
        "side": { "enum": ["base", "head"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "commit": {
          "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }],
          "description": "Commit the evidence refers to; null for uncommitted working-tree content."
        },
        "detail": { "type": "string", "description": "Short redacted descriptor. Never file contents." }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "category",
        "severity",
        "status",
        "confidence",
        "is_heuristic",
        "provenance",
        "summary",
        "explanation",
        "recommended_human_action",
        "evidence",
        "affected_modules"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+:[0-9a-f]{8}$" },
        "rule_id": { "type": "string" },
        "category": {
          "enum": [
            "public-api",
            "package-manifest",
            "broken-import",
            "deleted-module",
            "migration",
            "api-contract",
            "configuration",
            "security-sensitive",
            "test-change",
            "blast-radius"
          ]
        },
        "severity": { "enum": ["high", "medium", "low", "info"] },
        "status": {
          "enum": ["verified_static_fact", "hypothesis", "unknown"],
          "description": "verified_static_fact = determined by git/resolver/parser facts; hypothesis = convention or lexical inference; unknown = evidence insufficient to decide."
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "is_heuristic": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "summary": { "type": "string" },
        "explanation": { "type": "string" },
        "recommended_human_action": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "affected_modules": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
