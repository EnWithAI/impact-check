{
  "name": "@enwithai/changelens",
  "version": "0.2.0-alpha.0",
  "description": "Local-first, evidence-backed change-impact reports for JavaScript/TypeScript pull requests.",
  "license": "MIT",
  "author": "EnWithAI Technologies",
  "type": "module",
  "bin": {
    "changelens": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/changelens-report.schema.json": "./schema/changelens-report.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "schema/",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "keywords": [
    "code-review",
    "impact-analysis",
    "dependency-graph",
    "pull-request",
    "developer-tools",
    "github-actions"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:all": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
